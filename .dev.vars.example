# Copy to .dev.vars for local testing (`npm run dev`), and add the same names in
# Cloudflare → your Worker → Settings → Variables and Secrets for the live site.

# AI stylist (reads the quiz and photos, plans the looks). https://console.anthropic.com
ANTHROPIC_API_KEY=

# Real product photos, live prices and affiliate buy links. Free key at https://trychannel3.com
CHANNEL3_API_KEY=

# Optional: Skimlinks publisher ID. Turns any other store link into an affiliate link.
SKIMLINKS_ID=

# Optional: override the Claude model used by the stylist.
# ANTHROPIC_MODEL=claude-sonnet-5-5
